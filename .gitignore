*.gem
*.rbc
/.config
/coverage/
/InstalledFiles
/pkg/
/spec/reports/
/spec/examples.txt
/test/tmp/
/test/version_tmp/
/tmp/

# Used by dotenv library to load environment variables.
# .env

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# TODO Comment out this rule if you are OK with secrets being uploaded into the repo
config/initializers/secret_token.rb
config/master.key

# Only if using cookie session store
.db Sessions

# Ignore SQLite databases.
*.sqlite3
*.sqlite3-journal
*.sqlite3-wal
/storage/*.sqlite3*

# Ignore all storage.
/storage/*
!/storage/.keep

# Ignore public assets produced by propshaft.
/public/assets/

# Ignore master key for decrypting credentials and more.
/config/master.key

# Ignore Kamal deployment secrets.
/config/deploy.yml
.kamal/

# Ignore env files.
/.env*
!.env.example
